# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Dev:  http://localhost:5173
# Prod: https://trustvault-app.onrender.com  (update to your static site URL)
CLIENT_ORIGIN=http://localhost:5173

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local dev:   mongodb://127.0.0.1:27017/mohit_doc_viewer
# Production:  Get from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb://127.0.0.1:27017/mohit_doc_viewer

# ─── JWT (use long random strings in production) ─────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ISSUER=trustvault
JWT_AUDIENCE=trustvault-client
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Dev:  COOKIE_SECURE=false  COOKIE_SAMESITE=lax
# Prod: COOKIE_SECURE=true   COOKIE_SAMESITE=none  (cross-origin; requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── File storage ────────────────────────────────────────────────────────────
# Files are stored in MongoDB GridFS (same MONGODB_URI — no S3 needed)
MAX_FILE_SIZE_MB=10

# ─── Seed accounts (development only) ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin123!@#
SEED_EMPLOYEE_EMAIL=employee@company.com
SEED_EMPLOYEE_PASSWORD=Employee123!@#
