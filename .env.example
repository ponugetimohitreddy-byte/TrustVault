# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mohit_doc_viewer

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ISSUER=mohit-doc-viewer
JWT_AUDIENCE=mohit-doc-viewer-client
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# File storage: local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Amazon S3 (required when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_KMS_KEY_ID=

# Seed (development only)
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin123!@#
SEED_EMPLOYEE_EMAIL=employee@company.com
SEED_EMPLOYEE_PASSWORD=Employee123!@#
